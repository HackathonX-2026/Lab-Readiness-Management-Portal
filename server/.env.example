# --- CloudLabs source ---
# Your partner (tenant) GUID from the CloudLabs Admin URL:
# https://admin-vnext.cloudlabs.ai/<PARTNER_ID>/dashboard
CLOUDLABS_PARTNER_ID=

# Base URL for the CloudLabs API host observed in the recon.
CLOUDLABS_API_BASE=https://api-vnext.cloudlabs.ai

# Bearer token (JWT). See README section "Token acquisition" for the options.
# For a quick start, paste a fresh token copied from your browser DevTools:
#   1. Open admin-vnext.cloudlabs.ai, log in, open DevTools -> Network
#   2. Click any /api/... request, copy the Authorization header value AFTER "Bearer "
#   3. Paste it here. It typically expires in ~6 hours; you'll re-paste until an
#      MSAL client-credentials flow is wired up.
CLOUDLABS_ACCESS_TOKEN=

# --- Reference CloudLabs Admin catalog + test/review audit APIs ---
# Independent of the vNext credentials above. Never use VITE_ variables for tokens.
# Supply approved values directly in server/.env or the deployment secret store.
CLOUDLABS_BASE=https://api.cloudlabs.ai
CLOUDLABS_TOKEN=
CLOUDLABS_ROLEID=
CLOUDLABS_TENANTID=
CLOUDLABS_PARTNER_LABEL=

# For a temporary browser credential use "browser-session" and supply its exact expiry.
# Automatic OAuth renewal is NOT enabled in this app.
CLOUDLABS_AUTH_SOURCE=
CLOUDLABS_TOKEN_EXPIRES_AT=

# Keep personal data redacted unless the entire app/API is behind real server auth.
CLOUDLABS_INCLUDE_PII=0

# Optional shared server API key for catalog/audit/template reads that contact
# CloudLabs and workshop sync. Inject x-api-key via a trusted authenticated proxy
# or an authorized API client; never ship the key in the Vite bundle.
CLOUDLABS_REFRESH_API_KEY=

# Optional catalog-only scheduled refresh, using SYNC_CRON below. Audits are manual.
CLOUDLABS_CATALOG_SYNC_ENABLED=false

# --- Sync behavior ---
# Cron expression for the sync job. Every 10 minutes by default.
SYNC_CRON=*/10 * * * *

# Run a sync immediately on server start.
SYNC_ON_START=true

# Max pages to fetch per sync (safety cap). Each page = 100 items.
SYNC_MAX_PAGES=200

# Only sync workshops whose delivery date is within this many days of "now"
# (i.e. from `now - N days` and later — INCLUDES all future workshops too).
# Set to 0 to disable the window and sync everything.
SYNC_LOOKBACK_DAYS=20

# --- Storage ---
# SQLite database file (relative to server/ folder).
DB_PATH=./data/sync.db

# --- HTTP server ---
PORT=3001
# Local-only by default. Set 0.0.0.0 only behind an authenticated reverse proxy.
HOST=127.0.0.1

# Comma-separated allowed CORS origins (your Vite dev server + prod domain).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
LOG_LEVEL=info

# --- Email Alerts (Optional) ---
# Enable automated email alerts for labs nearing their workshop dates
EMAIL_ALERTS_ENABLED=false

# Cron expression for checking and sending alert emails. Every 30 minutes by default.
EMAIL_ALERT_CRON=*/30 * * * *

# SMTP server configuration for sending emails.
# Leave SMTP_HOST empty to disable email sending (will log alerts to console only).
# For production, configure with your organization's SMTP server or a service like SendGrid.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=lab-readiness@cloudlabs.local

# Email recipient for alerts (demo mode; production should query from a team/user table)
# Example: ALERT_MANAGER_EMAIL=manager@company.com
ALERT_MANAGER_EMAIL=
